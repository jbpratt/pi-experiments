{
  "name": "kube-approval",
  "version": "0.1.0",
  "description": "Approval gate for guarded oc/kubectl/aws bash commands in Pi",
  "type": "module",
  "files": [
    "extensions",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm pack --dry-run"
  },
  "keywords": [
    "pi-package",
    "pi",
    "kubernetes",
    "aws",
    "approval-gate"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-tui": "^0.82.1",
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "pi": {
    "extensions": [
      "./extensions/kube-approval.ts"
    ]
  }
}
