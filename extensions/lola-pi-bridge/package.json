{
  "name": "lola-pi-bridge",
  "version": "0.1.0",
  "description": "Expose Lola-managed Agent Skills directly to Pi",
  "type": "module",
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm pack --dry-run"
  },
  "keywords": [
    "pi-package",
    "pi",
    "lola",
    "agent-skills"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Marcusk19/lola-pi-bridge.git"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.81.1",
    "@earendil-works/pi-tui": "^0.81.1",
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "pi": {
    "extensions": [
      "./extensions/lola-sync.ts",
      "./extensions/lola-manage.ts"
    ]
  }
}
